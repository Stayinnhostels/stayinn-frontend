# Backend API (no trailing slash). Required on Vercel: NEXT_PUBLIC_API_BASE_URL
# Local: backend is :3000, this website is `npm run dev` on :3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Optional: separate dashboard/admin apps
# NEXT_PUBLIC_DASHBOARD_ORIGIN=https://stayinndashboard.vercel.app
# NEXT_PUBLIC_ADMIN_ORIGIN=https://stayinndashboard.vercel.app
